---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { jobs, applyEmail } from "../data/jobs";

const mail = (subject: string) => `mailto:${applyEmail}?subject=${encodeURIComponent(subject)}`;
---

<Base
  title="Careers | GridFlow"
  description="Work at GridFlow: help build long-duration vanadium flow battery storage in Albuquerque, New Mexico."
  darkHeader
>
  <PageHeader
    title="Careers"
    lede="Help build long-duration storage for the grid, here in New Mexico. We hire locally first and look for people who like solving real problems with hardware, chemistry and code."
  />

  <section class="jobs">
    <div class="wrap">
      <h2>Open roles</h2>
      {
        jobs.length > 0 ? (
          <ul class="job-list">
            {jobs.map((j) => (
              <li>
                <div>
                  <h3>{j.title}</h3>
                  <p class="meta">
                    {j.type}, {j.location}
                  </p>
                  <p class="summary">{j.summary}</p>
                </div>
                <a class="btn btn-blue" href={mail(`Application: ${j.title}`)}>
                  Apply by email
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty">
            <p>We don't have any open roles right now.</p>
            <p class="empty-sub">
              We're growing, though. If you'd like to work on grid storage in New Mexico, email us your résumé and a few
              lines about what you'd like to work on, and we'll keep you in mind.
            </p>
            <a class="btn btn-blue" href={mail("Interested in working at GridFlow")}>
              Email {applyEmail}
            </a>
          </div>
        )
      }

      <div class="how">
        <h2>How to apply</h2>
        <p>
          Email <a href={mail("Application")}>{applyEmail}</a> with the role in the subject line, your résumé, and a
          short note about why the work interests you. We read every message.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .jobs {
    padding-block: clamp(56px, 8vw, 96px) var(--section);
  }
  .jobs h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  .job-list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }
  .job-list li {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 24px;
    padding-block: 24px;
    border-top: 1px solid var(--rule);
  }
  .job-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .meta {
    margin-top: 4px;
    color: var(--blue);
    font-weight: 600;
  }
  .summary {
    margin-top: 8px;
    color: var(--muted);
  }
  .empty {
    margin-top: 28px;
    padding: 32px;
    background: var(--white);
    border-radius: 20px;
  }
  .empty > p:first-child {
    font-size: 1.25rem;
    font-weight: 650;
  }
  .empty-sub {
    margin-top: 10px;
    color: var(--muted);
  }
  .empty .btn {
    margin-top: 24px;
  }
  .how {
    margin-top: 72px;
  }
  .how p {
    margin-top: 12px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .job-list li {
      flex-direction: column;
    }
  }
</style>
