---
import { u } from "../lib/url";
import type { Person } from "../data/team";

interface Props {
  person: Person;
  headingLevel?: "h2" | "h3";
}

const { person: p, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const initials = p.name
  .replace("Dr. ", "")
  .split(" ")
  .map((w) => w[0])
  .join("");
---

<li class="person">
  {
    p.photo ? (
      <img class="avatar" src={u(p.photo)} alt="" width="96" height="96" loading="lazy" />
    ) : (
      <span class="avatar initials" aria-hidden="true">
        {initials}
      </span>
    )
  }
  <Heading class="name">{p.name}</Heading>
  <p class="role">{p.role}</p>
  <p class="bio">{p.bio}</p>
  <a class="linkedin" href={p.linkedin} rel="noopener" aria-label={`${p.name} on LinkedIn`}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        fill="currentColor"
        d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
      ></path>
    </svg>
    LinkedIn
  </a>
</li>

<style>
  .person {
    border-top: 1px solid var(--rule);
    padding-top: 20px;
  }
  .avatar {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--deep);
    margin-bottom: 16px;
  }
  .initials {
    display: grid;
    place-items: center;
    color: var(--white);
    font-weight: 700;
    font-stretch: 112%;
    font-size: 1.75rem;
  }
  .name {
    font-size: 1.25rem;
    font-weight: 680;
    line-height: 1.25;
  }
  .role {
    margin-top: 2px;
    color: var(--blue);
    font-weight: 600;
  }
  .bio {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .linkedin {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .linkedin:hover {
    text-decoration: underline;
  }
</style>
